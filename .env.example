# Public, general edition that the root route redirects to.
REWIND_LATEST_EDITION=2026
REWIND_SITE_ORIGIN=https://rewind.c3.com.sv

# Keep false until the general editorial checklist is approved.
REWIND_GENERAL_PUBLISHED=false
REWIND_INDEX_GENERAL=false

# Public resource endpoint. Leave blank to use local media files.
IMAGEKIT_URL_ENDPOINT=

# Local PDF generation only. Start `npm run dev` before using scripts.
REWIND_PDF_BASE_URL=http://localhost:3000
