{
  "name": "c3-rewind",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "content:validate": "tsx scripts/validate-content.ts",
    "token:create": "tsx scripts/recipient-token.mjs create",
    "token:revoke": "tsx scripts/recipient-token.mjs revoke",
    "token:rotate": "tsx scripts/recipient-token.mjs rotate",
    "pdf:general": "tsx scripts/generate-pdf.ts --general",
    "pdf:recipient": "tsx scripts/generate-pdf.ts --recipient",
    "pdf:all": "tsx scripts/generate-pdf.ts --all",
    "pdf:edition": "tsx scripts/generate-pdf.ts --edition"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
